SESSION_SECRET=generate-a-random-64-char-hex-string-here
GMAIL_USER=your-email@gmail.com
GMAIL_APP_PASSWORD=your-gmail-app-password-here

# /import's column-mapping LLM. Both are optional -- with neither set, the
# import flow still works end to end via a deterministic heuristic mapper,
# the user just does more of the column mapping by hand. If both are set,
# Gemini is preferred; set MAPPING_PROVIDER to force a specific one.
GEMINI_API_KEY=your-gemini-api-key-here
ANTHROPIC_API_KEY=your-anthropic-api-key-here
# MAPPING_PROVIDER=gemini|anthropic|manual
